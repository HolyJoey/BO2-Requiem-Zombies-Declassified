napalm_zombie_init()
{
    init_napalm_fx();
    level.napalmzombiesenabled = 1;
    level.napalmzombieminroundwait = 1;
    level.napalmzombiemaxroundwait = 2;
    level.napalmzombieroundrequirement = 5;
    level.nextnapalmspawnround = level.napalmzombieroundrequirement + randomintrange( 0, level.napalmzombiemaxroundwait + 1 );
    level.napalmzombiedamageradius = 250;
    level.napalmexploderadius = 90;
    level.napalmexplodekillradiusjugs = 90;
    level.napalmexplodekillradius = 150;
    level.napalmexplodedamageradius = 400;
    level.napalmexplodedamageradiuswet = 250;
    level.napalmexplodedamagemin = 50;
    level.napalmhealthmultiplier = 4;
    level.last_special_zombie_round = 0;
    level.active_napalm_zombies = [];
    level.napalm_zombie_spawners = getentarray( "napalm_zombie_spawner", "script_noteworthy" );

    if ( getdvar( "zombiemode_debug_napalm" ) == "" )
        setdvar( "zombiemode_debug_napalm", "0" );

    flag_init( "zombie_napalm_force_spawn" );
    array_thread( level.napalm_zombie_spawners, ::add_spawn_function, ::napalm_zombie_spawn );
    array_thread( level.napalm_zombie_spawners, ::add_spawn_function, maps\mp\zombies\_zm::round_spawn_failsafe );
    init_ambsounds();
    maps\mp\zombies\_zm_spawner::register_zombie_damage_callback( ::_napalm_damage_callback );
    level thread napalm_zombie_spawnthink();
    level thread watch_napalm_debug_dvar();
}

// Console command: setdvar zombiemode_debug_napalm 1
// Forces a napalm zombie to spawn on the next check, then resets itself.
watch_napalm_debug_dvar()
{
    while ( true )
    {
        if ( getdvarint( "zombiemode_debug_napalm" ) == 1 )
        {
            setdvar( "zombiemode_debug_napalm", "0" );
            flag_set( "zombie_napalm_force_spawn" );
        }

        wait 0.5;
    }
}

get_napalm_spawners()
{
    return level.napalm_zombie_spawners;
}

get_napalm_locations()
{
    return level.zombie_napalm_locations;
}

napalm_spawn_check()
{
    forcespawn = flag( "zombie_napalm_force_spawn" );

    if ( !isdefined( level.napalmzombiesenabled ) || level.napalmzombiesenabled == 0 || level.napalm_zombie_spawners.size == 0 || level.zombie_napalm_locations.size == 0 )
        return false;

    if ( isdefined( level.napalmzombiecount ) && level.napalmzombiecount > 0 )
        return false;

    if ( level.last_special_zombie_round >= level.round_number )
        return false;

    // Fr0sty: never with a screamer (sonic zombie) alive - BO1 allowed one special zombie at a time
    if ( isdefined( level.soniczombiecount ) && level.soniczombiecount > 0 )
        return false;

    if ( forcespawn )
    {
        flag_clear( "zombie_napalm_force_spawn" );
        level.last_special_zombie_round = level.round_number;
        return true;
    }

    if ( level.nextnapalmspawnround > level.round_number )
        return false;

    if ( level.zombie_total == 0 )
        return false;

    if ( level.zombie_total >= level.zombiesleftbeforenapalmspawn )
        return false;

    // Fr0sty: claim the round the moment the check passes. The port only marked it once the napalm had spawned, so the
    // screamer's own check (a separate thread) could pass in between and both spawned in the same round.
    level.last_special_zombie_round = level.round_number;
    return true;
}

napalm_zombie_spawnthink()
{
    level waittill( "start_of_round" );

    while ( true )
    {
        if ( napalm_spawn_check() )
        {
            spawner_list = get_napalm_spawners();
            location_list = get_napalm_locations();
            spawner = random( spawner_list );
            location = random( location_list );
            ai = spawn_zombie( spawner, spawner.targetname, location );

            if ( isdefined( ai ) )
                ai.spawn_point_override = location;
        }

        wait 3;
    }
}

do_napalm_spawn( napalm_zombie )
{
    self endon( "death" );
    level thread napalm_fire_trigger( self, 80, 6, 1 );
    playfx( level._effect["napalm_spawn"], self.origin, anglestoforward( self.angles ), ( 0, 0, 1 ) );
    thread do_napalm_spawn_t7();
}

do_napalm_spawn_t7()
{
    wait 2;
    players = level.players;
    players[randomintrange( 0, players.size )] thread maps\mp\zombies\_zm_audio::create_and_play_dialog( "general", "napalm_spawn" );
}

