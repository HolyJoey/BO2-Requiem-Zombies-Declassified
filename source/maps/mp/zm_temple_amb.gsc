main()
{
    level._audio_custom_weapon_check = ::weapon_type_check_custom;
    level._custom_intro_vox = ::intro_vox_or_skit;
    level thread setup_meteor_audio();
    level thread visual_trigger_vox( "location_maze" );
    level thread visual_trigger_vox( "location_waterfall" );
    level thread visual_trigger_vox( "mine_see" );
    level thread endgame_vox();
}

weapon_type_check_custom( weapon, magic_box )
{
    self.entity_num = self.characterindex;

    switch ( self.entity_num )
    {
        case 0:
            if ( weapon == "m16_zm" )
                return "favorite";
            else if ( weapon == "m16_gl_upgraded_zm" )
                return "favorite_upgrade";

            break;
        case 1:
            if ( weapon == "fnfal_zm" )
                return "favorite";

            break;
        case 2:
            if ( weapon == "ak74u_zm" )
                return "favorite";
            else if ( weapon == "m14_upgraded_zm" )
                return "favorite_upgrade";

            break;
    }

    if ( issubstr( weapon, "upgraded" ) )
        return "upgrade";
    else
        return level.zombie_weapons[weapon].vox;
}

endgame_vox()
{
    level waittill( "end_game" );
    wait 2;
    winner = undefined;
    players = level.players;

    for ( i = 0; i < players.size; i++ )
    {
        if ( isdefined( players[i]._has_anti115 ) && players[i]._has_anti115 == 1 )
        {
            winner = players[i];
            break;
        }
    }

    if ( isdefined( winner ) )
    {
        num = winner getentitynumber();

        if ( isdefined( winner.zm_random_char ) )
            num = winner.zm_random_char;

        if ( num == 3 )
            playsoundatposition( "vox_plr_3_gameover_1", ( 0, 0, 0 ) );
        else
            playsoundatposition( "vox_plr_3_gameover_0", ( 0, 0, 0 ) );
    }
}

setup_meteor_audio()
{
    wait 3;
    origins = [];
    origins[0] = ( 351.5, -1253, 2.5 );
    origins[1] = ( 578.8, -1570.8, -416 );
    origins[2] = ( -1459.5, -1069, -74 );
    level.teddy_counter = 0;
    level.music_override = 0;

    for ( i = 0; i < origins.size; i++ )
        level thread sndmusicegg_wait( origins[i] );
}

sndmusicegg_wait( origin )
{
    temp_ent = spawn( "script_origin", origin );
    temp_ent playloopsound( "zmb_meteor_loop" );
    temp_ent thread maps\mp\zombies\_zm_sidequests::fake_use( "main_music_egg_hit", ::sndmusicegg_override );
    temp_ent waittill( "main_music_egg_hit", player );
    temp_ent stoploopsound( 1 );
    player playsound( "zmb_meteor_activate" );
    player maps\mp\zombies\_zm_audio::create_and_play_dialog( "eggs", "meteors", undefined, level.teddy_counter );
    level.teddy_counter = level.teddy_counter + 1;
    temp_ent delete();

    if ( level.teddy_counter == 3 )
        level thread sndmuseggplay( 360, player );
    else
        wait 1.5;
}

sndmusicegg_override()
{
    if ( is_true( level.music_override ) )
        return false;

    return true;
}

sndmuseggplay( time, player )
{
    level.music_override = 1;
    wait 1;
    level thread maps\mp\zombies\_zm_audio::change_zombie_music( "egg" );
    wait 4;

    if ( isdefined( player ) )
        player maps\mp\zombies\_zm_audio::create_and_play_dialog( "eggs", "music_activate" );

    level thread sndeggmusicwait( time );
    level waittill_either( "end_game", "sndSongDone" );
    wait 0.05;
    level.music_override = 0;
    level.teddy_counter = 0;
    level thread maps\mp\zombies\_zm_audio::change_zombie_music( "wave_loop" );
}

sndeggmusicwait( time )
{
    level endon( "end_game" );
    wait( time );
    level notify( "sndSongDone" );
}

intro_vox_or_skit()
{
    playsoundatposition( "evt_warp_in", ( 0, 0, 0 ) );
    wait 3;
    players = level.players;

    if ( players.size == 4 && randomintrange( 0, 101 ) <= 10 )
    {
        if ( randomintrange( 0, 101 ) <= 10 )
            players[randomintrange( 0, players.size )] thread maps\mp\zombies\_zm_audio::create_and_play_dialog( "eggs", "rod" );
        else
        {
            num = randomintrange( 0, 2 );
            level thread maps\mp\zm_temple_sq_skits::start_skit( "start" + num, players );
        }
    }
    else
        players[randomintrange( 0, players.size )] thread maps\mp\zombies\_zm_audio::create_and_play_dialog( "general", "start" );
}

visual_trigger_vox( place )
{
    wait 3;
    struct = getstruct( "vox_" + place, "targetname" );

    if ( !isdefined( struct ) )
        return;

    vox_trig = spawn( "trigger_radius", struct.origin - ( 0, 0, 100 ), 0, 250, 200 );

    while ( true )
    {
        vox_trig waittill( "trigger", who );

        if ( isplayer( who ) )
        {
            who thread maps\mp\zombies\_zm_audio::create_and_play_dialog( "general", place );

            if ( place == "location_maze" )
                wait 90;
            else
                break;
        }
    }

    vox_trig delete();
}
