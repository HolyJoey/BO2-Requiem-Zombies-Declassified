meat_stink_powerup_grab( powerup, who )
{
    switch ( powerup.powerup_name )
    {
        case "meat_stink":
            level thread meat_stink( who );
            break;
    }
}

meat_stink( who )
{
    weapons = who getweaponslist();
    has_meat = 0;

    foreach ( weapon in weapons )
    {
        if ( weapon == "item_meat_zm" )
            has_meat = 1;
    }

    if ( has_meat )
        return;

    who.pre_meat_weapon = who getcurrentweapon();
    level notify( "meat_grabbed" );
    who notify( "meat_grabbed" );
    who playsound( "zmb_pickup_meat" );
    who increment_is_drinking();
    who giveweapon( "item_meat_zm" );
    who switchtoweapon( "item_meat_zm" );
    who setweaponammoclip( "item_meat_zm", 1 );
}

meat_stink_on_ground( position_to_play )
{
    level.meat_on_ground = 1;
    attractor_point = spawn( "script_model", position_to_play );
    attractor_point setmodel( "tag_origin" );
    attractor_point playsound( "zmb_land_meat" );
    wait 0.2;
    playfxontag( level._effect["meat_stink_torso"], attractor_point, "tag_origin" );
    attractor_point playloopsound( "zmb_meat_flies" );
    attractor_point create_zombie_point_of_interest( 1536, 32, 10000 );
    attractor_point.attract_to_origin = 1;
    attractor_point thread create_zombie_point_of_interest_attractor_positions( 4, 45 );
    attractor_point thread maps\mp\zombies\_zm_weap_cymbal_monkey::wait_for_attractor_positions_complete();
    attractor_point delay_thread( 15, ::self_delete );
    wait 16.0;
    level.meat_on_ground = undefined;
}

meat_bounce_override( pos, normal, ent )
{
    if ( isdefined( ent ) && isplayer( ent ) )
    {
        if ( !ent maps\mp\zombies\_zm_laststand::player_is_in_laststand() )
        {
            level thread meat_stink_player( ent );

            if ( isdefined( self.owner ) )
            {
                maps\mp\_demo::bookmark( "zm_player_meat_stink", gettime(), ent, self.owner, 0, self );
                self.owner maps\mp\zombies\_zm_stats::increment_client_stat( "contaminations_given" );
            }
        }
    }
    else
    {
        players = getplayers();
        closest_player = undefined;
        closest_player_dist = 10000.0;

        for ( player_index = 0; player_index < players.size; player_index++ )
        {
            player_to_check = players[player_index];

            if ( self.owner == player_to_check )
                continue;

            if ( player_to_check maps\mp\zombies\_zm_laststand::player_is_in_laststand() )
                continue;

            distsq = distancesquared( pos, player_to_check.origin );

            if ( distsq < closest_player_dist )
            {
                closest_player = player_to_check;
                closest_player_dist = distsq;
            }
        }

        if ( isdefined( closest_player ) )
        {
            level thread meat_stink_player( closest_player );

            if ( isdefined( self.owner ) )
            {
                maps\mp\_demo::bookmark( "zm_player_meat_stink", gettime(), closest_player, self.owner, 0, self );
                self.owner maps\mp\zombies\_zm_stats::increment_client_stat( "contaminations_given" );
            }
        }
        else
        {
            valid_poi = check_point_in_enabled_zone( pos, undefined, undefined );

            if ( valid_poi )
            {
                self hide();
                level thread meat_stink_on_ground( self.origin );
            }
        }

        playfx( level._effect["meat_impact"], self.origin );
    }

    self delete();
}

meat_stink_player( who )
{
    level notify( "new_meat_stink_player" );
    level endon( "new_meat_stink_player" );
    who.ignoreme = 0;
    players = get_players();

    foreach ( player in players )
    {
        player thread meat_stink_player_cleanup();

        if ( player != who )
            player.ignoreme = 1;
    }

    who thread meat_stink_player_create();
    who waittill_any_or_timeout( 30, "disconnect", "player_downed", "bled_out" );
    players = get_players();

    foreach ( player in players )
    {
        player thread meat_stink_player_cleanup();
        player.ignoreme = 0;
    }
}

meat_stink_player_create()
{
    self maps\mp\zombies\_zm_stats::increment_client_stat( "contaminations_received" );
    self endon( "disconnect" );
    self endon( "death" );
    tagname = "J_SpineLower";
    self.meat_stink_3p = spawn( "script_model", self gettagorigin( tagname ) );
    self.meat_stink_3p setmodel( "tag_origin" );
    self.meat_stink_3p linkto( self, tagname );
    wait 0.5;
    playfxontag( level._effect["meat_stink_torso"], self.meat_stink_3p, "tag_origin" );

    if ( !is_true( level.kino_no_meat_stink_clientfield ) )
        self setclientfieldtoplayer( "meat_stink", 1 );
}

meat_stink_player_cleanup()
{
    if ( isdefined( self.meat_stink_3p ) )
    {
        self.meat_stink_3p unlink();
        self.meat_stink_3p delete();
    }

    if ( !is_true( level.kino_no_meat_stink_clientfield ) )
        self setclientfieldtoplayer( "meat_stink", 0 );
}

door_close_zombie_think()
{
    self endon( "death" );

    while ( isalive( self ) )
    {
        if ( isdefined( self.enemy ) && isplayer( self.enemy ) )
        {
            insamezone = 0;
            keys = getarraykeys( level.zones );

            for ( i = 0; i < keys.size; i++ )
            {
                if ( self maps\mp\zombies\_zm_zonemgr::entity_in_zone( keys[i] ) && self.enemy maps\mp\zombies\_zm_zonemgr::entity_in_zone( keys[i] ) )
                    insamezone = 1;
            }

            if ( insamezone )
            {
                wait 3;
                continue;
            }

            nearestzombienode = getnearestnode( self.origin );
            nearestplayernode = getnearestnode( self.enemy.origin );

            if ( isdefined( nearestzombienode ) && isdefined( nearestplayernode ) )
            {
                if ( !nodesvisible( nearestzombienode, nearestplayernode ) && !nodescanpath( nearestzombienode, nearestplayernode ) )
                    self silentlyremovezombie();
            }
        }

        wait 1;
    }
}

silentlyremovezombie()
{
    level.zombie_total++;
    playfx( level._effect["spawn_cloud"], self.origin );
    self.skip_death_notetracks = 1;
    self.nodeathragdoll = 1;
    self dodamage( self.maxhealth * 2, self.origin, self, self, "none", "MOD_SUICIDE" );
    self self_delete();
}

zgrief_player_bled_out_msg()
{
    level endon( "end_game" );
    self endon( "disconnect" );

    while ( true )
    {
        self waittill( "bled_out" );
        level thread update_players_on_bleedout_or_disconnect( self );
    }
}

show_grief_hud_msg( msg, msg_parm, offset, cleanup_end_game )
{
    self endon( "disconnect" );

    while ( isdefined( level.hostmigrationtimer ) )
        wait 0.05;

    zgrief_hudmsg = newclienthudelem( self );
    zgrief_hudmsg.alignx = "center";
    zgrief_hudmsg.aligny = "middle";
    zgrief_hudmsg.horzalign = "center";
    zgrief_hudmsg.vertalign = "middle";
    zgrief_hudmsg.y = zgrief_hudmsg.y - 130;

    if ( self issplitscreen() )
        zgrief_hudmsg.y = zgrief_hudmsg.y + 70;

    if ( isdefined( offset ) )
        zgrief_hudmsg.y = zgrief_hudmsg.y + offset;

    zgrief_hudmsg.foreground = 1;
    zgrief_hudmsg.fontscale = 5;
    zgrief_hudmsg.alpha = 0;
    zgrief_hudmsg.color = ( 1, 1, 1 );
    zgrief_hudmsg.hidewheninmenu = 1;
    zgrief_hudmsg.font = "default";

    if ( isdefined( cleanup_end_game ) && cleanup_end_game )
    {
        level endon( "end_game" );
        zgrief_hudmsg thread show_grief_hud_msg_cleanup();
    }

    if ( isdefined( msg_parm ) )
        zgrief_hudmsg settext( msg, msg_parm );
    else
        zgrief_hudmsg settext( msg );

    zgrief_hudmsg changefontscaleovertime( 0.25 );
    zgrief_hudmsg fadeovertime( 0.25 );
    zgrief_hudmsg.alpha = 1;
    zgrief_hudmsg.fontscale = 2;
    wait 3.25;
    zgrief_hudmsg changefontscaleovertime( 1 );
    zgrief_hudmsg fadeovertime( 1 );
    zgrief_hudmsg.alpha = 0;
    zgrief_hudmsg.fontscale = 5;
    wait 1;
    zgrief_hudmsg notify( "death" );

    if ( isdefined( zgrief_hudmsg ) )
        zgrief_hudmsg destroy();
}

show_grief_hud_msg_cleanup()
{
    self endon( "death" );
    level waittill( "end_game" );

    if ( isdefined( self ) )
        self destroy();
}

grief_reset_message()
{
    msg = &"ZOMBIE_GRIEF_RESET";
    players = get_players();

    if ( isdefined( level.hostmigrationtimer ) )
    {
        while ( isdefined( level.hostmigrationtimer ) )
            wait 0.05;

        wait 4;
    }

    foreach ( player in players )
        player thread show_grief_hud_msg( msg );

    level thread maps\mp\zombies\_zm_audio_announcer::leaderdialog( "grief_restarted" );
}

grief_laststand_weapon_save( einflictor, attacker, idamage, smeansofdeath, sweapon, vdir, shitloc, psoffsettime, deathanimduration )
{
    self.grief_savedweapon_weapons = self getweaponslist();
    self.grief_savedweapon_weaponsammo_stock = [];
    self.grief_savedweapon_weaponsammo_clip = [];
    self.grief_savedweapon_currentweapon = self getcurrentweapon();
    self.grief_savedweapon_grenades = self get_player_lethal_grenade();

    if ( isdefined( self.grief_savedweapon_grenades ) )
        self.grief_savedweapon_grenades_clip = self getweaponammoclip( self.grief_savedweapon_grenades );

    self.grief_savedweapon_tactical = self get_player_tactical_grenade();

    if ( isdefined( self.grief_savedweapon_tactical ) )
        self.grief_savedweapon_tactical_clip = self getweaponammoclip( self.grief_savedweapon_tactical );

    for ( i = 0; i < self.grief_savedweapon_weapons.size; i++ )
    {
        self.grief_savedweapon_weaponsammo_clip[i] = self getweaponammoclip( self.grief_savedweapon_weapons[i] );
        self.grief_savedweapon_weaponsammo_stock[i] = self getweaponammostock( self.grief_savedweapon_weapons[i] );
    }

    if ( isdefined( self.hasriotshield ) && self.hasriotshield )
        self.grief_hasriotshield = 1;

    if ( self hasweapon( "claymore_zm" ) )
    {
        self.grief_savedweapon_claymore = 1;
        self.grief_savedweapon_claymore_clip = self getweaponammoclip( "claymore_zm" );
    }

    if ( isdefined( self.current_equipment ) )
        self.grief_savedweapon_equipment = self.current_equipment;
}

grief_laststand_weapons_return()
{
    if ( !( isdefined( level.isresetting_grief ) && level.isresetting_grief ) )
        return false;

    if ( !isdefined( self.grief_savedweapon_weapons ) )
        return false;

    primary_weapons_returned = 0;

    foreach ( index, weapon in self.grief_savedweapon_weapons )
    {
        if ( isdefined( self.grief_savedweapon_grenades ) && weapon == self.grief_savedweapon_grenades || isdefined( self.grief_savedweapon_tactical ) && weapon == self.grief_savedweapon_tactical )
            continue;

        if ( isweaponprimary( weapon ) )
        {
            if ( primary_weapons_returned >= 2 )
                continue;

            primary_weapons_returned++;
        }

        if ( "item_meat_zm" == weapon )
            continue;

        self giveweapon( weapon, 0, self maps\mp\zombies\_zm_weapons::get_pack_a_punch_weapon_options( weapon ) );

        if ( isdefined( self.grief_savedweapon_weaponsammo_clip[index] ) )
            self setweaponammoclip( weapon, self.grief_savedweapon_weaponsammo_clip[index] );

        if ( isdefined( self.grief_savedweapon_weaponsammo_stock[index] ) )
            self setweaponammostock( weapon, self.grief_savedweapon_weaponsammo_stock[index] );
    }

    if ( isdefined( self.grief_savedweapon_grenades ) )
    {
        self giveweapon( self.grief_savedweapon_grenades );

        if ( isdefined( self.grief_savedweapon_grenades_clip ) )
            self setweaponammoclip( self.grief_savedweapon_grenades, self.grief_savedweapon_grenades_clip );
    }

    if ( isdefined( self.grief_savedweapon_tactical ) )
    {
        self giveweapon( self.grief_savedweapon_tactical );

        if ( isdefined( self.grief_savedweapon_tactical_clip ) )
            self setweaponammoclip( self.grief_savedweapon_tactical, self.grief_savedweapon_tactical_clip );
    }

    if ( isdefined( self.current_equipment ) )
        self maps\mp\zombies\_zm_equipment::equipment_take( self.current_equipment );

    if ( isdefined( self.grief_savedweapon_equipment ) )
    {
        self.do_not_display_equipment_pickup_hint = 1;
        self maps\mp\zombies\_zm_equipment::equipment_give( self.grief_savedweapon_equipment );
        self.do_not_display_equipment_pickup_hint = undefined;
    }

    if ( isdefined( self.grief_hasriotshield ) && self.grief_hasriotshield )
    {
        if ( isdefined( self.player_shield_reset_health ) )
            self [[ self.player_shield_reset_health ]]();
    }

    if ( isdefined( self.grief_savedweapon_claymore ) && self.grief_savedweapon_claymore )
    {
        self giveweapon( "claymore_zm" );
        self set_player_placeable_mine( "claymore_zm" );
        self setactionslot( 4, "weapon", "claymore_zm" );
        self setweaponammoclip( "claymore_zm", self.grief_savedweapon_claymore_clip );
    }

    primaries = self getweaponslistprimaries();

    foreach ( weapon in primaries )
    {
        if ( isdefined( self.grief_savedweapon_currentweapon ) && self.grief_savedweapon_currentweapon == weapon )
        {
            self switchtoweapon( weapon );
            return true;
        }
    }

    if ( primaries.size > 0 )
    {
        self switchtoweapon( primaries[0] );
        return true;
    }

    assert( primaries.size > 0, "GRIEF: There was a problem restoring the weapons" );
    return false;
}

grief_store_player_scores()
{
    players = get_players();

    foreach ( player in players )
        player._pre_round_score = player.score;
}

grief_restore_player_score()
{
    if ( !isdefined( self._pre_round_score ) )
        self._pre_round_score = self.score;

    if ( isdefined( self._pre_round_score ) )
    {
        self.score = self._pre_round_score;
        self.pers["score"] = self._pre_round_score;
    }
}

game_mode_spawn_player_logic()
{
    if ( flag( "start_zombie_round_logic" ) && !isdefined( self.is_hotjoin ) )
    {
        self.is_hotjoin = 1;
        return true;
    }

    return false;
}

update_players_on_bleedout_or_disconnect( excluded_player )
{
    other_team = undefined;
    players = get_players();
    players_remaining = 0;

    foreach ( player in players )
    {
        if ( player == excluded_player )
            continue;

        if ( player.team == excluded_player.team )
        {
            if ( is_player_valid( player ) )
                players_remaining++;

            continue;
        }
    }

    foreach ( player in players )
    {
        if ( player == excluded_player )
            continue;

        if ( player.team != excluded_player.team )
        {
            other_team = player.team;

            if ( players_remaining < 1 )
            {
                player thread show_grief_hud_msg( &"ZOMBIE_ZGRIEF_ALL_PLAYERS_DOWN", undefined, undefined, 1 );
                player delay_thread_watch_host_migrate( 2, ::show_grief_hud_msg, &"ZOMBIE_ZGRIEF_SURVIVE", undefined, 30, 1 );
                continue;
            }

            player thread show_grief_hud_msg( &"ZOMBIE_ZGRIEF_PLAYER_BLED_OUT", players_remaining );
        }
    }

    if ( players_remaining == 1 )
        level thread maps\mp\zombies\_zm_audio_announcer::leaderdialog( "last_player", excluded_player.team );

    if ( !isdefined( other_team ) )
        return;

    if ( players_remaining < 1 )
        level thread maps\mp\zombies\_zm_audio_announcer::leaderdialog( "4_player_down", other_team );
    else
        level thread maps\mp\zombies\_zm_audio_announcer::leaderdialog( players_remaining + "_player_left", other_team );
}

delay_thread_watch_host_migrate( timer, func, param1, param2, param3, param4, param5, param6 )
{
    self thread _delay_thread_watch_host_migrate_proc( func, timer, param1, param2, param3, param4, param5, param6 );
}

_delay_thread_watch_host_migrate_proc( func, timer, param1, param2, param3, param4, param5, param6 )
{
    self endon( "death" );
    self endon( "disconnect" );
    wait( timer );

    if ( isdefined( level.hostmigrationtimer ) )
    {
        while ( isdefined( level.hostmigrationtimer ) )
            wait 0.05;

        wait( timer );
    }

    single_thread( self, func, param1, param2, param3, param4, param5, param6 );
}

grief_round_end_custom_logic()
{
    waittillframeend;

    if ( isdefined( level.gamemodulewinningteam ) )
        level notify( "end_round_think" );
}

// ---------------------------------------------------------------------------
// DLC5 Kino der Toten - Grief at start location "stage" (main theater + stage)
// ---------------------------------------------------------------------------

kino_register_grief()
{
    add_map_gamemode( "zgrief", ::kino_zgrief_preinit, undefined, undefined );
    add_map_location_gamemode( "zgrief", "stage", ::kino_grief_precache, ::kino_grief_main );
    println( "KINOGRIEF >> registered zgrief/stage (ui_zm_mapstartlocation=" + getdvar( "ui_zm_mapstartlocation" ) + ")" );
}

kino_zgrief_preinit()
{
    // No "meat_stink" clientfield on Kino: the ported map's client never runs zgrief.csc premain,
    // so registering it here disconnects with EXE_CLIENT_FIELD_MISMATCH. Only the camera fx is lost.
    level.kino_no_meat_stink_clientfield = 1;
    level.gamemode_post_spawn_logic = ::kino_grief_post_spawn;
    println( "KINOGRIEF >> preinit" );
    kino_retag_classic_objects( "preinit" );
    kino_install_team_death_fix();

    // Kino sets start_zombie_round_logic before the first player spawn, so stock
    // game_mode_spawn_player_logic() treats everyone as a hot-joiner and spawns them as a
    // spectator (looks like dying on load). Only count joins after the intro blackscreen.
    level.game_mode_spawn_player_logic = ::kino_game_mode_spawn_player_logic;
}

kino_game_mode_spawn_player_logic()
{
    if ( isdefined( self.is_hotjoin ) )
        return false;

    if ( flag_exists( "initial_blackscreen_passed" ) && flag( "initial_blackscreen_passed" ) )
    {
        self.is_hotjoin = 1;
        println( "KINOGRIEF >> " + self.name + " hot-joined - spectating until next round" );
        return true;
    }

    self.is_hotjoin = 0;
    return false;
}

// Perk machines, the box etc. are spawned from structs/ents whose script_string lists
// "<gametype>_..._<location>" tokens (zclassic_perks_theater ...). Grief at "stage" finds none,
// so add a zgrief/stage twin of every zclassic token. Jugg and double tap swap places.
kino_retag_classic_objects( when )
{
    if ( is_true( level.kino_retag_done ) )
        return;

    things = [];

    if ( isdefined( level.struct ) )
    {
        foreach ( s in level.struct )
            things[things.size] = s;
    }

    ents = getentarray();

    foreach ( e in ents )
        things[things.size] = e;

    retagged = 0;
    swapped = 0;

    foreach ( t in things )
    {
        if ( isdefined( t.script_string ) && issubstr( t.script_string, "zclassic" ) )
        {
            tokens = strtok( t.script_string, " " );
            extra = "";

            foreach ( token in tokens )
            {
                if ( token.size < 8 || getsubstr( token, 0, 8 ) != "zclassic" )
                    continue;

                twin = "zgrief" + getsubstr( token, 8, token.size );

                if ( twin.size >= 8 && getsubstr( twin, twin.size - 8, twin.size ) == "_theater" )
                    twin = getsubstr( twin, 0, twin.size - 8 ) + "_stage";

                if ( !issubstr( t.script_string, twin ) )
                    extra = extra + " " + twin;
            }

            if ( extra != "" )
            {
                tn = "";

                if ( isdefined( t.targetname ) )
                    tn = t.targetname;

                println( "KINOGRIEF >> retag " + tn + " '" + t.script_string + "' +" + extra );
                t.script_string = t.script_string + extra;
                retagged++;
            }
        }

        if ( !is_true( level.kino_perkswap_done ) && isdefined( t.script_noteworthy ) && isdefined( t.targetname ) && t.targetname == "zm_perk_machine" )
        {
            if ( t.script_noteworthy == "specialty_armorvest" )
            {
                t.script_noteworthy = "specialty_rof";
                swapped++;
            }
            else if ( t.script_noteworthy == "specialty_rof" )
            {
                t.script_noteworthy = "specialty_armorvest";
                swapped++;
            }
        }
    }

    if ( retagged > 0 )
        level.kino_retag_done = 1;

    if ( swapped > 0 )
        level.kino_perkswap_done = 1;

    println( "KINOGRIEF >> retag (" + when + "): " + retagged + " object(s) retagged, " + swapped + " perk slot(s) swapped, " + things.size + " scanned" );
    kino_move_perks( when );
}

// Perk / PaP spots picked in game with whereami (2026-09-13). The machine spawns from its
// zm_perk_machine struct, so moving the struct before the perks spawn moves machine + collision.
// Yaw is the direction the player faced (back to the wall); if a machine ends up backwards,
// add 180 to that entry.
kino_move_perks( when )
{
    if ( is_true( level.kino_perks_moved ) || !isdefined( level.struct ) )
        return;

    spots = [];
    spots["specialty_weapupgrade"] = array( ( -297.0, 1093.8, -0.9 ), 24.9 );
    spots["specialty_fastreload"] = array( ( 623.6, 1251.1, -15.9 ), 179.6 );
    spots["specialty_quickrevive"] = array( ( -215.1, 1880.4, -15.9 ), 357.6 );
    spots["specialty_additionalprimaryweapon"] = array( ( -793.7, 1275.2, -15.9 ), 90.0 );
    moved = 0;

    foreach ( s in level.struct )
    {
        if ( !isdefined( s.targetname ) || s.targetname != "zm_perk_machine" || !isdefined( s.script_noteworthy ) )
            continue;

        ang = ( 0, 0, 0 );

        if ( isdefined( s.angles ) )
            ang = s.angles;

        println( "KINOGRIEF >> perk struct " + s.script_noteworthy + " at " + s.origin + " angles " + ang );

        if ( !isdefined( spots[s.script_noteworthy] ) )
            continue;

        spot = spots[s.script_noteworthy];
        s.origin = spot[0];
        s.angles = ( 0, spot[1], 0 );
        moved++;
        println( "KINOGRIEF >> perk moved " + s.script_noteworthy + " -> " + s.origin + " yaw " + spot[1] );
    }

    if ( moved > 0 )
        level.kino_perks_moved = 1;

    println( "KINOGRIEF >> perks (" + when + "): moved " + moved + " (expect 4)" );
}

kino_grief_precache()
{
    // _zm_gametype::game_objects_allowed() deletes every entity whose script_gameobjectname
    // isn't tagged for this mode/location. Kino only tags things for classic, so it wiped the
    // perks and broke the box. Untag everything first (runs before rungametypemain).
    ents = getentarray();
    cleared = 0;

    foreach ( ent in ents )
    {
        if ( isdefined( ent.script_gameobjectname ) )
        {
            ent.script_gameobjectname = undefined;
            cleared++;
        }
    }

    println( "KINOGRIEF >> precache: kept " + cleared + " classic-tagged entities" );
    kino_retag_classic_objects( "precache" );
    precachemodel( "collision_clip_wall_128x128x10" );
    // Team revive icons set client-side by scripts/zm/zzz_kinoreviveicon.csc.
    precacheshader( "waypoint_revive_mp" );
    precacheshader( "waypoint_revive_spetsnaz" );
    precacheshader( "faction_mp" );
    precacheshader( "faction_spetsnaz" );
    precachemodel( "p6_zm_bu_street_blocker_crates" );
    precachemodel( "p6_zm_al_door_barricade_1" );
    precachemodel( "p6_zm_bu_crate_01" );
}

kino_grief_main()
{
    println( "KINOGRIEF >> main" );
    level thread kino_grief_early_zones();
    flag_wait( "start_zombie_round_logic" );
    wait 0.5;
    kino_grief_barricades();
    kino_grief_lock_doors();
    kino_grief_open_foyer_door();
    kino_grief_limit_zones();
    kino_grief_filter_foyer_spawns();
    println( "KINOGRIEF >> area limited to theater + stage + front foyer" );
    kino_grief_power_on();
    level thread kino_grief_box();
    kino_fix_weapon_limit();
}

kino_grief_power_on()
{
    trig = getent( "use_elec_switch", "targetname" );
    players = get_players();

    if ( isdefined( trig ) && players.size > 0 )
    {
        trig notify( "trigger", players[0] );
        println( "KINOGRIEF >> power: fired use_elec_switch" );
    }
    else
        println( "KINOGRIEF >> power: no use_elec_switch trigger" );

    wait 2;

    if ( !flag_exists( "power_on" ) )
    {
        println( "KINOGRIEF >> power: no power_on flag on this map" );
        return;
    }

    if ( !flag( "power_on" ) )
    {
        flag_set( "power_on" );
        println( "KINOGRIEF >> power: switch didn't set power_on, set it directly" );
    }
    else
        println( "KINOGRIEF >> power: on" );
}

kino_zone_of_point( pos )
{
    probe = spawn( "script_origin", pos + ( 0, 0, 16 ) );
    found = "none";

    foreach ( name, zone in level.zones )
    {
        if ( !isdefined( zone.volumes ) )
            continue;

        foreach ( vol in zone.volumes )
        {
            if ( probe istouching( vol ) )
                found = name;
        }
    }

    probe delete();
    return found;
}

// Encounter locations build the box themselves (Buried's street_treasure_chest_init does
// level.chests = ... + treasure_chest_init). Kino's classic box setup never runs in grief, so
// build it here from the chest structs inside the theater/stage and hide every other location.
kino_grief_box()
{
    structs = getstructarray( "treasure_chest_use", "targetname" );
    println( "KINOGRIEF >> box: " + structs.size + " treasure_chest_use struct(s)" );

    if ( structs.size == 0 )
    {
        foreach ( s in level.struct )
        {
            if ( isdefined( s.targetname ) && issubstr( s.targetname, "chest" ) || isdefined( s.script_noteworthy ) && issubstr( s.script_noteworthy, "chest" ) )
            {
                tn = "";
                sn = "";

                if ( isdefined( s.targetname ) )
                    tn = s.targetname;

                if ( isdefined( s.script_noteworthy ) )
                    sn = s.script_noteworthy;

                println( "KINOGRIEF >> box: candidate struct tn=" + tn + " sn=" + sn + " at " + s.origin );
            }
        }

        return;
    }

    keep = [];

    foreach ( s in structs )
    {
        zone = kino_zone_of_point( s.origin );
        sn = "?";

        if ( isdefined( s.script_noteworthy ) )
            sn = s.script_noteworthy;

        println( "KINOGRIEF >> box: chest '" + sn + "' " + s.origin + " zone=" + zone );

        if ( zone == "theater_zone" || zone == "stage_zone" )
            keep[keep.size] = s;
        else
            kino_hide_chest_location( s );
    }

    if ( keep.size == 0 )
    {
        println( "KINOGRIEF >> box: no chest inside theater/stage" );
        return;
    }

    level.chests = keep;
    start = keep[randomint( keep.size )];
    start_name = "start_chest";

    if ( isdefined( start.script_noteworthy ) )
        start_name = start.script_noteworthy;

    // Random start: zzz_zm_boxstart re-rolls via init_starting_chest_location("start_chest")
    // and, non-random, that looks for the VIP "start_chest" we removed -> every chest hidden.
    level.random_pandora_box_start = 1;
    maps\mp\zombies\_zm_magicbox::treasure_chest_init( start_name );
    println( "KINOGRIEF >> box: " + keep.size + " location(s), started at '" + start_name + "'" );
    wait 3;
    active = level.chests[level.chest_index];

    if ( is_true( active.hidden ) )
    {
        f = getfunction( "maps/mp/zombies/_zm_magicbox", "init_starting_chest_location" );

        if ( isdefined( f ) )
            [[ f ]]( "start_chest" );

        active = level.chests[level.chest_index];
        println( "KINOGRIEF >> box: active chest was hidden, re-rolled -> '" + active.script_noteworthy + "' hidden=" + is_true( active.hidden ) );
    }
    else
        println( "KINOGRIEF >> box: active '" + active.script_noteworthy + "' visible" );
}

kino_hide_chest_location( s )
{
    if ( !isdefined( s.script_noteworthy ) )
        return;

    parts = getentarray( s.script_noteworthy + "_zbarrier", "script_noteworthy" );

    if ( isdefined( s.target ) )
    {
        targeted = getentarray( s.target, "targetname" );

        foreach ( t in targeted )
            parts[parts.size] = t;
    }

    foreach ( part in parts )
    {
        part hide();
        part notsolid();
    }

    println( "KINOGRIEF >> box: hid '" + s.script_noteworthy + "' (" + parts.size + " ent(s))" );
}

// Doors out of the theater/stage stay shut: remove their buy triggers.
kino_grief_lock_doors()
{
    locked = array( "dress_door", "backstage_door", "foyer_top_door", "foyer_bottom_door" );
    trigs = getentarray( "zombie_door", "targetname" );
    removed = 0;

    foreach ( trig in trigs )
    {
        if ( !isdefined( trig.target ) )
            continue;

        foreach ( name in locked )
        {
            if ( trig.target == name )
            {
                trig delete();
                removed++;
                break;
            }
        }
    }

    println( "KINOGRIEF >> removed " + removed + " door buy trigger(s) (expect 5)" );
}

// The spawn room (foyer) is part of the grief area: open the theater <-> foyer door for free.
kino_grief_open_foyer_door()
{
    trigs = getentarray( "zombie_door", "targetname" );
    opener = getfunction( "maps/mp/zombies/_zm_blockers", "door_opened" );
    used = 0;

    foreach ( trig in trigs )
    {
        if ( !isdefined( trig ) || !isdefined( trig.target ) || trig.target != "theater_to_foyer_door" )
            continue;

        if ( isdefined( opener ) && !used )
        {
            trig thread [[ opener ]]( 0 );
            used = 1;
            println( "KINOGRIEF >> foyer door: opened via _zm_blockers::door_opened" );
        }
    }

    if ( used )
        return;

    // Fallback: remove the door pieces and triggers directly.
    bodies = getentarray( "theater_to_foyer_door", "targetname" );

    foreach ( body in bodies )
    {
        body connectpaths();
        body delete();
    }

    foreach ( trig in trigs )
    {
        if ( isdefined( trig ) && isdefined( trig.target ) && trig.target == "theater_to_foyer_door" )
            trig delete();
    }

    println( "KINOGRIEF >> foyer door: door_opened not found, removed " + bodies.size + " door piece(s)" );
}

// Barricade lines picked in game (both ends of each gap, standing on the floor).
kino_grief_barricades()
{
    // If the crate piles stand sideways across the gap, change this to 90.
    level.kino_barricade_prop_yaw_offset = 90;
    // Crate piles stacked this many high, this far apart vertically.
    level.kino_barricade_layers = 4;
    // Extra collision rows this far either side of the line, so players can't walk into the crates.
    level.kino_barricade_depths = array( -30, 30 );
    level.kino_barricade_layer_height = 40;
    // If the door boards stand sideways, change this to 90.
    level.kino_door_barricade_yaw_offset = 90;
    // How far past the whereami spot (toward the door) the boards sit.
    level.kino_door_board_out = 12;
    // Distance from each door-board row's centre to each of its two boards (makes rows longer).
    level.kino_door_board_half_length = 24;
    level.kino_door_board_up = 22;
    level.kino_door_board_left = 2;

    kino_barricade_line( ( 126.2, -767.8, 80.1 ), ( -136.1, -762.7, 80.1 ), "1", 3 );
    kino_barricade_line( ( -206.1, -744.4, 80.1 ), ( -202.7, -657.7, 80.6 ), "2", 4 );
    kino_grief_door_barricades();
}

// Invisible 128-wide clip walls every <=96 units along the line, two rows high, blocking
// players and zombies. Extra length past the ends just sinks into the side walls.
kino_barricade_line( a, b, name, layers )
{
    delta = b - a;
    len = length( ( delta[0], delta[1], 0 ) );
    yaw = vectortoangles( ( delta[0], delta[1], 0 ) )[1];
    count = int( len / 96 ) + 1;
    normal = anglestoright( ( 0, yaw, 0 ) );
    floor_z = a[2];

    if ( b[2] < floor_z )
        floor_z = b[2];

    pieces = 0;

    for ( i = 0; i <= count; i++ )
    {
        frac = ( i * 1.0 ) / count;
        p = ( a[0] + delta[0] * frac, a[1] + delta[1] * frac, floor_z );

        for ( row = 0; row < 2; row++ )
        {
            foreach ( side in level.kino_barricade_depths )
            {
                wall = spawn( "script_model", p + normal * side + ( 0, 0, 120 * row ), 1 );
                wall.angles = ( 0, yaw, 0 );
                wall setmodel( "collision_clip_wall_128x128x10" );
                wall disconnectpaths();
                pieces++;
            }

            wall = spawn( "script_model", p + ( 0, 0, 120 * row ), 1 );
            wall.angles = ( 0, yaw, 0 );
            wall setmodel( "collision_clip_wall_128x128x10" );
            wall disconnectpaths();
            pieces++;
        }
    }

    // Visible props (shipped in DLC5 mod.ff): Buried street-blocker crate piles along the line,
    // with single Buried crates at both ends.
    piles = int( len / 85 ) + 1;

    for ( i = 0; i < piles; i++ )
    {
        frac = ( i + 0.5 ) / piles;
        pos = ( a[0] + delta[0] * frac, a[1] + delta[1] * frac, floor_z );
        for ( layer = 0; layer < layers; layer++ )
        {
            lpos = pos + ( 0, 0, layer * level.kino_barricade_layer_height );
            kino_spawn_prop( "p6_zm_bu_street_blocker_crates", lpos, yaw + level.kino_barricade_prop_yaw_offset + randomintrange( -6, 6 ), name + "_pile" + i + "_L" + layer );
        }
    }

    kino_spawn_prop( "p6_zm_bu_crate_01", ( a[0], a[1], floor_z ), yaw + 15, name + "_crateA" );
    println( "KINOGRIEF >> barricade " + name + ": length " + len + " yaw " + yaw + " -> " + pieces + " clip piece(s), " + piles + " crate pile(s)" );
}

// Foyer zombie spawners behind the barricades would spawn zombies nobody can reach.
kino_grief_filter_foyer_spawns()
{
    names = array( "foyer_zone", "foyer2_zone" );

    foreach ( zname in names )
    {
        zone = level.zones[zname];

        if ( !isdefined( zone ) || !isdefined( zone.spawn_locations ) )
            continue;

        foreach ( loc in zone.spawn_locations )
        {
            blocked = loc.origin[1] < -765 || loc.origin[0] < -204;

            if ( blocked )
                loc.is_enabled = 0;

            println( "KINOGRIEF >> " + zname + " spawner " + loc.origin + " blocked=" + blocked );
        }
    }
}

// The out-of-playable-area monitor kills anyone standing in a zone that isn't enabled
// (logged: DAMAGE 1650 MOD_UNKNOWN from worldspawn 0.6s after spawn). Kino only enables the
// foyer at load, so enable theater/stage the moment the zones exist - before anyone spawns.
kino_grief_early_zones()
{
    for ( t = 0; t < 600; t++ )
    {
        if ( isdefined( level.zones ) && isdefined( level.zones["theater_zone"] ) && isdefined( level.zones["stage_zone"] ) )
            break;

        wait 0.05;
    }

    if ( !isdefined( level.zones ) || !isdefined( level.zones["theater_zone"] ) )
    {
        println( "KINOGRIEF >> early zones: theater_zone never appeared" );
        return;
    }

    level thread maps\mp\zombies\_zm_zonemgr::enable_zone( "theater_zone" );
    level thread maps\mp\zombies\_zm_zonemgr::enable_zone( "stage_zone" );
    level thread maps\mp\zombies\_zm_zonemgr::enable_zone( "foyer_zone" );
    level thread maps\mp\zombies\_zm_zonemgr::enable_zone( "foyer2_zone" );
    println( "KINOGRIEF >> early zones: theater + stage + foyer zones enabled at t=" + t * 0.05 + " players=" + get_players().size );
}

kino_grief_limit_zones()
{
    keep = array( "theater_zone", "stage_zone", "foyer_zone", "foyer2_zone" );

    foreach ( zone in keep )
    {
        if ( isdefined( level.zones[zone] ) )
            level thread maps\mp\zombies\_zm_zonemgr::enable_zone( zone );
        else
            println( "KINOGRIEF >> zone missing: " + zone );
    }

    foreach ( zoneindex, zone in level.zones )
    {
        should_disable = 1;

        foreach ( kept in keep )
        {
            if ( zoneindex == kept )
                should_disable = 0;
        }

        if ( should_disable )
        {
            zone.is_enabled = 0;
            zone.is_spawning_allowed = 0;
        }
    }
}

// Spawn spots picked in game with whereami (2026-09-13):
//   team A (axis)   stage  (445.7, 1650.3, -15.9) facing 240.6
//   team B (allies) theater (-305.2, -301.6, 0.1)  facing 54.8
// Extra players on the same team get small offsets around the spot.
kino_grief_post_spawn()
{
    if ( !isdefined( level.kino_grief_spawn_count ) )
    {
        level.kino_grief_spawn_count = [];
        level.kino_grief_spawn_count["A"] = 0;
        level.kino_grief_spawn_count["B"] = 0;
    }

    team = "B";

    if ( isdefined( self._encounters_team ) )
        team = self._encounters_team;

    offsets = array( ( 0, 0, 0 ), ( 40, 0, 0 ), ( -40, 0, 0 ), ( 0, 40, 0 ), ( 0, -40, 0 ), ( 40, 40, 0 ), ( -40, -40, 0 ), ( 40, -40, 0 ) );
    i = level.kino_grief_spawn_count[team] % offsets.size;
    level.kino_grief_spawn_count[team]++;

    if ( team == "A" )
    {
        origin = ( 445.7, 1650.3, -15.9 ) + offsets[i];
        angles = ( 0, 240.6, 0 );
    }
    else
    {
        origin = ( -305.2, -301.6, 0.1 ) + offsets[i];
        angles = ( 0, 54.8, 0 );
    }

    self setorigin( origin );
    self setplayerangles( angles );
    println( "KINOGRIEF >> " + self.name + " team " + team + " -> " + origin + " zone=" + kino_zone_of_point( origin ) );
}

// Replacement for _zm_game_module::wait_for_team_death_and_round_end (Kino only, via replaceFunc).
// Same logic as stock, but (1) it waits until a player is actually alive/valid before it starts,
// so the spawn-in frame no longer counts as "everyone dead" and triggers a grief reset, and
// (2) with a single player in the match it never starts the empty-team round-end check.
kino_install_team_death_fix()
{
    f = getfunction( "maps/mp/zombies/_zm_game_module", "wait_for_team_death_and_round_end" );

    if ( !isdefined( f ) )
    {
        println( "KINOGRIEF >> team death fix: stock function not found" );
        return;
    }

    replacefunc( f, ::kino_wait_for_team_death_and_round_end, -1 );
    println( "KINOGRIEF >> team death fix installed" );
}

kino_wait_for_team_death_and_round_end()
{
    level endon( "game_module_ended" );
    level endon( "end_game" );
    checking_for_round_end = 0;
    level.isresetting_grief = 0;
    valid_time = 0;

    while ( valid_time < 2 )
    {
        any_valid = 0;

        foreach ( player in get_players() )
        {
            if ( isdefined( player._encounters_team ) && is_player_valid( player ) )
                any_valid = 1;
        }

        if ( any_valid )
            valid_time = valid_time + 0.05;
        else
            valid_time = 0;

        wait 0.05;
    }

    println( "KINOGRIEF >> team death watch started" );

    while ( true )
    {
        cdc_alive = 0;
        cia_alive = 0;
        players = get_players();

        foreach ( player in players )
        {
            if ( !isdefined( player._encounters_team ) )
                continue;

            if ( player._encounters_team == "A" )
            {
                if ( is_player_valid( player ) )
                    cia_alive++;

                continue;
            }

            if ( is_player_valid( player ) )
                cdc_alive++;
        }

        if ( cia_alive == 0 && cdc_alive == 0 && !level.isresetting_grief && !( isdefined( level.host_ended_game ) && level.host_ended_game ) )
        {
            wait 0.5;
            println( "KINOGRIEF >> all players down - grief reset" );

            if ( isdefined( level._grief_reset_message ) )
                level thread [[ level._grief_reset_message ]]();

            level.isresetting_grief = 1;
            level notify( "end_round_think" );
            level.zombie_vars["spectators_respawn"] = 1;
            level notify( "keep_griefing" );
            checking_for_round_end = 0;
            maps\mp\zombies\_zm_game_module::zombie_goto_round( level.round_number );
            level thread maps\mp\zombies\_zm_game_module::reset_grief();
            level thread maps\mp\zombies\_zm::round_think( 1 );
        }
        else if ( !checking_for_round_end && players.size > 1 )
        {
            if ( cia_alive == 0 )
            {
                level thread maps\mp\zombies\_zm_game_module::check_for_round_end( "B" );
                checking_for_round_end = 1;
            }
            else if ( cdc_alive == 0 )
            {
                level thread maps\mp\zombies\_zm_game_module::check_for_round_end( "A" );
                checking_for_round_end = 1;
            }
        }

        if ( cia_alive > 0 && cdc_alive > 0 )
        {
            level notify( "stop_round_end_check" );
            checking_for_round_end = 0;
        }

        wait 0.05;
    }
}

// Kino installs its own level.get_player_weapon_limit, which doesn't limit anything in grief
// (logged 4 primaries without Mule Kick). Use the stock rule: 2 guns, 3 with Mule Kick.
kino_fix_weapon_limit()
{
    old = level.get_player_weapon_limit;
    level.get_player_weapon_limit = ::kino_player_weapon_limit;

    if ( isdefined( old ) )
    {
        players = get_players();

        if ( players.size > 0 )
            println( "KINOGRIEF >> weapons: Kino's limit function returned " + [[ old ]]( players[0] ) + " - replaced with 2 / 3 (mule)" );
        else
            println( "KINOGRIEF >> weapons: replaced Kino's limit function with 2 / 3 (mule)" );
    }
}

kino_player_weapon_limit( player )
{
    if ( player hasperk( "specialty_additionalprimaryweapon" ) )
    {
        if ( isdefined( level.additionalprimaryweapon_limit ) )
            return level.additionalprimaryweapon_limit;

        return 3;
    }

    return 2;
}

kino_spawn_prop( model, pos, yaw, name )
{
    prop = spawn( "script_model", pos );
    prop.angles = ( 0, yaw, 0 );
    prop setmodel( model );
    println( "KINOGRIEF >> prop " + name + " " + model + " at " + pos + " yaw " + yaw );
    return prop;
}

// Plank barricades (Mob of the Dead) on two locked doors, from spots picked in game with whereami:
// the player stood in front of the door looking at it. Boards go just in front of that spot,
// facing the player, three boards each tilted/turned a little differently.
kino_grief_door_barricades()
{
    kino_door_boards( "foyer_bottom_door", ( -562.1, -637.6, 80.1 ), 180, 1.0 );
    kino_door_boards( "dress_door", ( 729.3, 1540.5 - 3, -15.9 + 10 ), 0, 1.25 );
}

// size: 1.0 = the foyer door layout; larger spreads the rows further apart and makes them longer.
kino_door_boards( dname, spot, facing, size )
{
    fwd = anglestoforward( ( 0, facing, 0 ) );
    // Shift: + up / + left, as seen by a player facing the door.
    base = spot + fwd * level.kino_door_board_out + anglestoright( ( 0, facing, 0 ) ) * ( level.kino_door_board_left * -1 ) + ( 0, 0, level.kino_door_board_up );
    // Per row: diagonal tilt in the door plane (pitch: + = one end down), height, small yaw jitter.
    pitches = array( 10, 0, 8 );
    heights = array( 0, 26, 52 );
    yaws = array( 0, 2, -1 );

    for ( i = 0; i < 3; i++ )
    {
        yaw = facing + level.kino_door_barricade_yaw_offset + yaws[i];
        ang = ( pitches[i], yaw, 0 );
        along = anglestoforward( ang );
        centre = base + fwd * ( i * -2 ) + ( 0, 0, heights[i] * size );

        // Two boards end to end along the tilted direction so the row spans the door.
        for ( j = 0; j < 2; j++ )
        {
            offset = level.kino_door_board_half_length * size;

            if ( j == 1 )
                offset = offset * -1;

            prop = kino_spawn_prop( "p6_zm_al_door_barricade_1", centre + along * offset, yaw, "door_" + dname + "_" + i + "_" + j );
            prop.angles = ang;
        }
    }
}

kino_point_in_grief_area( pos )
{
    zone = kino_zone_of_point( pos );
    return zone == "theater_zone" || zone == "stage_zone" || zone == "foyer_zone" || zone == "foyer2_zone";
}
